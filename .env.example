# Company Recipient Email (where workshop quote requests are sent)
COMPANY_EMAIL=Sales@primeageindustries.com.au

# Option 1: Gmail / Standard SMTP credentials (RECOMMENDED FOR GMAIL)
# For Gmail, generate an App Password in your Google Account:
# Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_COMPANY_EMAIL@gmail.com
SMTP_PASS=your-16-char-gmail-app-password

# Option 2: Resend API Key (ALTERNATIVE)
# RESEND_API_KEY=re_123456789
# RESEND_FROM=onboarding@resend.dev
